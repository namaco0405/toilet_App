{
  "expo": {
    "name": "toilet_App",
    "slug": "toilet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "toiletapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toilet.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "現在地を表示するために位置情報を使用します",
        "NSLocationAlwaysUsageDescription": "トイレの位置情報を正確に記録するために使用します",
        "NSCameraUsageDescription": "トイレの写真を撮影するために使用します",
        "NSPhotoLibraryUsageDescription": "トイレの写真をアップロードするために使用します"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "com.toilet.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "位置情報を使用します"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "写真ライブラリへのアクセスを許可します",
          "cameraPermission": "カメラへのアクセスを許可します"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
